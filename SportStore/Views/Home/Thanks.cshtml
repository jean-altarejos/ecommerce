@model GuestResponse

<div class="text-center">
    <h1>Thanks! @Model?.Name!</h1>
    @if(Model.WillAttend == true)
    {
        @: It's great that you're coming.
        @: The drinks are in the fridge!
    }
    else
    {
        @:Sorry to hear that you're can't make it,
        @:but thanks for letting me know.
    }
</div>
CLick <a asp-action="ListResponses">here</a> to see who's coming.
